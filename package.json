{
  "name": "padroes-de-projeto",
  "version": "1.0.0",
  "description": "Projeto de estudos de padrões de projeto em TypeScript",
  "type": "commonjs",
  "scripts": {
    "build:strategy": "swc strategy/ -d dist --copy-files",
    "build:observer": "swc observer/ -d dist --copy-files",
    "build:decorators": "swc decorators/ -d dist --copy-files",
    "clean": "rm -rf dist",
    "start:guerreiro": "npm run build:strategy && node dist/strategy/classes/guerreiro.js",
    "start:observer": "npm run build:observer && node dist/observer/classes/produto.js",
    "start:decorators": "npm run build:decorators && node dist/decorators/classes/sistema.js"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.7",
    "typescript": "^5.9.3"
  }
}
